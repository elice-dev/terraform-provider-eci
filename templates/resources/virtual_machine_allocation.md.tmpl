### Start/Stop with a Variable

Use a variable to start and stop the VM without modifying code:

```terraform
variable "vm_running" {
  description = "Set to false to stop the VM without deleting it"
  type        = bool
  default     = true
}

resource "eci_virtual_machine_allocation" "my_vm_alloc" {
  count      = var.vm_running ? 1 : 0
  machine_id = eci_virtual_machine.my_vm.id
  tags = {
    "created-by" = "terraform"
  }
  depends_on = [
    eci_block_storage.boot_disk,
    eci_network_interface.my_nic,
    eci_public_ip.my_ip
  ]
}
```

```bash
# Start the VM (default)
terraform apply

# Stop the VM (infrastructure stays intact)
terraform apply -var="vm_running=false"

# Start again
terraform apply -var="vm_running=true"
```

~> **NOTE:** Stopping a VM (destroying the allocation) may take several minutes while the OS shuts down gracefully.

